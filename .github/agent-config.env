# Daily Improvement Agent Configuration

# Agent behavior settings
AGENT_ENABLED=true
AUTO_FIX_ENABLED=true
CREATE_PULL_REQUESTS=true
CREATE_ISSUES=true

# Improvement features (set to false to disable)
CHECK_DEPENDENCIES=true
RUN_SECURITY_AUDIT=true
IMPROVE_CODE_QUALITY=true
OPTIMIZE_PERFORMANCE=true
UPDATE_DOCUMENTATION=true
AI_CODE_REVIEW=true

# Update policies
AUTO_UPDATE_PATCH=true
AUTO_UPDATE_MINOR=false
AUTO_UPDATE_MAJOR=false

# Security policies
AUTO_FIX_VULNERABILITIES=true
VULNERABILITY_THRESHOLD=moderate

# Code quality settings
ENABLE_LINTER_AUTOFIX=true
ENFORCE_TYPE_CHECKING=true
CHECK_CODE_PATTERNS=true

# Performance settings
CHECK_BUNDLE_SIZE=true
DETECT_UNUSED_DEPS=true

# Documentation settings
AUTO_UPDATE_README=true
GENERATE_CHANGELOGS=false

# AI Settings (requires GEMINI_API_KEY secret)
AI_ENABLED=true
AI_MAX_FILES_TO_REVIEW=3
AI_REVIEW_TEMPERATURE=0.3

# Notification settings
NOTIFY_ON_HIGH_PRIORITY=true
NOTIFY_ON_SECURITY_ISSUES=true
